<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="28dp">

        <!-- TARJETA ENCABEZADO DEL DOCUMENTO -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/blanco"
            app:cardCornerRadius="22dp"
            app:cardElevation="1dp"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- TIPO DE DOCUMENTO Y FECHA DE RECEPCIÓN -->
                <TextView
                    android:id="@+id/tipo_fecha_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/oficio_recibido"
                    android:textColor="@color/gris_texto"
                    android:textSize="13sp" />

                <!-- ASUNTO -->
                <TextView
                    android:id="@+id/asunto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/asunto_del_documento"
                    android:textColor="@color/texto_principal"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- BADGES DE ESTADOS E INDICADORES -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/badges_top"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />

                </HorizontalScrollView>

                <!-- BOTONES DE ACCIÓN RÁPIDA (CHIPS/ACCIONES SUPERIORES: Turnar, Compartir, Atender, Responder, Anotar) -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/container_acciones_header"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />

                </HorizontalScrollView>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- BARRA DE PESTAÑAS (PILL TABS: Datos, PDF, OCR, Trámite, Anotaciones, Historial) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="14dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tab_datos"
                    style="@style/Widget.Material3.Button.UnelevatedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:text="@string/tab_datos"
                    android:textAllCaps="false"
                    android:textColor="@color/g_white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/g_verde"
                    app:cornerRadius="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tab_pdf"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:text="@string/pdf"
                    android:textAllCaps="false"
                    android:textColor="@color/gris_texto"
                    android:textSize="13sp"
                    app:cornerRadius="20dp"
                    app:strokeColor="#CBD5E1"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tab_ocr"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:text="@string/ocr"
                    android:textAllCaps="false"
                    android:textColor="@color/gris_texto"
                    android:textSize="13sp"
                    app:cornerRadius="20dp"
                    app:strokeColor="#CBD5E1"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tab_tramite"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:text="@string/tramite"
                    android:textAllCaps="false"
                    android:textColor="@color/gris_texto"
                    android:textSize="13sp"
                    app:cornerRadius="20dp"
                    app:strokeColor="#CBD5E1"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tab_anotaciones"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:text="@string/anotaciones"
                    android:textAllCaps="false"
                    android:textColor="@color/gris_texto"
                    android:textSize="13sp"
                    app:cornerRadius="20dp"
                    app:strokeColor="#CBD5E1"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tab_historial"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="@string/historial"
                    android:textAllCaps="false"
                    android:textColor="@color/gris_texto"
                    android:textSize="13sp"
                    app:cornerRadius="20dp"
                    app:strokeColor="#CBD5E1"
                    app:strokeWidth="1dp" />

            </LinearLayout>

        </HorizontalScrollView>

        <!-- CONTENIDO DE LAS PESTAÑAS -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- ========================================================= -->
            <!-- PESTAÑA 1: DATOS GENERALES -->
            <!-- ========================================================= -->
            <LinearLayout
                android:id="@+id/content_tab_datos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- INFORMACIÓN DEL DOCUMENTO -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/blanco"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#E2E8F0"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:text="@string/informacion_del_documento"
                            android:textColor="@color/texto_principal"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/container_info"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- ========================================================= -->
            <!-- PESTAÑA 2: PDF -->
            <!-- ========================================================= -->
            <LinearLayout
                android:id="@+id/content_tab_pdf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/blanco"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#E2E8F0"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:id="@+id/pdf_nombre"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/documento_pdf"
                            android:textColor="@color/gris_texto"
                            android:textSize="13sp" />

                        <!-- VISTA PREVIA DE PÁGINAS PDF -->
                        <LinearLayout
                            android:id="@+id/container_pdf_paginas"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="vertical" />

                        <!-- BOTONES RECARGAR Y COMPARTIR -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_recargar_pdf"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:text="@string/recargar"
                                android:textAllCaps="false"
                                android:textColor="@color/texto_principal"
                                app:cornerRadius="14dp"
                                app:strokeColor="#CBD5E1" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_compartir_pdf"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:text="@string/compartir"
                                android:textAllCaps="false"
                                android:textColor="@color/g_verde"
                                app:cornerRadius="14dp"
                                app:icon="@drawable/ic_forward"
                                app:iconTint="@color/g_verde"
                                app:strokeColor="@color/g_verde" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- ========================================================= -->
            <!-- PESTAÑA 3: OCR -->
            <!-- ========================================================= -->
            <LinearLayout
                android:id="@+id/content_tab_ocr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/blanco"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#E2E8F0"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/texto_reconocido_ocr"
                                android:textColor="@color/texto_principal"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_copiar_ocr"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="38dp"
                                android:text="@string/copiar"
                                android:textAllCaps="false"
                                android:textColor="@color/g_verde"
                                android:textSize="12sp"
                                app:cornerRadius="12dp"
                                app:strokeColor="@color/g_verde" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_ocr_texto"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:lineSpacingExtra="4dp"
                            android:text="@string/sin_texto_ocr"
                            android:textColor="@color/texto_principal"
                            android:textSize="14sp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- ========================================================= -->
            <!-- PESTAÑA 4: TRÁMITE -->
            <!-- ========================================================= -->
            <LinearLayout
                android:id="@+id/content_tab_tramite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- 1. RUTA DEL TRÁMITE -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/blanco"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#E2E8F0"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ruta_del_tramite"
                            android:textColor="@color/texto_principal"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <!-- LISTA DE PASOS DEL FLUJO INSTITUCIONAL -->
                        <LinearLayout
                            android:id="@+id/container_pasos_tramite"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="vertical" />

                        <!-- BOTONES DE ACCIÓN DEL TRÁMITE -->
                        <LinearLayout
                            android:id="@+id/container_acciones"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="horizontal" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 2. ÁRBOL DE ASIGNACIÓN -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/blanco"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#E2E8F0"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/arbol_de_asignacion"
                            android:textColor="@color/texto_principal"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/empty_asignaciones"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/sin_asignaciones"
                            android:textColor="@color/gris_texto"
                            android:textSize="14sp" />

                        <LinearLayout
                            android:id="@+id/container_asignaciones"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="vertical" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 3. RESPUESTAS OFICIALES -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/blanco"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#E2E8F0"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/respuestas_oficiales"
                            android:textColor="@color/texto_principal"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/empty_respuestas"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/sin_respuestas"
                            android:textColor="@color/gris_texto"
                            android:textSize="14sp" />

                        <LinearLayout
                            android:id="@+id/container_respuestas"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="vertical" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 4. DOCUMENTOS RELACIONADOS -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/blanco"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#E2E8F0"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/documentos_relacionados"
                            android:textColor="@color/texto_principal"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/empty_relaciones"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/sin_documentos_relacionados"
                            android:textColor="@color/gris_texto"
                            android:textSize="14sp" />

                        <LinearLayout
                            android:id="@+id/container_relaciones"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="vertical" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_vincular"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="14dp"
                            android:text="@string/vincular_documento"
                            android:textAllCaps="false"
                            android:textColor="@color/g_verde"
                            android:visibility="gone"
                            app:cornerRadius="14dp"
                            app:strokeColor="@color/g_verde" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- ========================================================= -->
            <!-- PESTAÑA 5: ANOTACIONES -->
            <!-- ========================================================= -->
            <LinearLayout
                android:id="@+id/content_tab_anotaciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/blanco"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#E2E8F0"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_nueva_anotacion_top"
                            style="@style/Widget.Material3.Button.UnelevatedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginBottom="16dp"
                            android:text="@string/nueva_anotacion"
                            android:textAllCaps="false"
                            android:textColor="@color/blanco"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/g_verde"
                            app:cornerRadius="22dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/anotaciones_del_documento"
                            android:textColor="@color/texto_principal"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/empty_anotaciones"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/sin_anotaciones"
                            android:textColor="@color/gris_texto"
                            android:textSize="14sp" />

                        <LinearLayout
                            android:id="@+id/container_anotaciones"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="vertical" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_anotar"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="16dp"
                            android:text="@string/anadir_anotacion"
                            android:textAllCaps="false"
                            android:textColor="@color/g_verde"
                            android:visibility="gone"
                            app:cornerRadius="14dp"
                            app:strokeColor="@color/g_verde" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- ========================================================= -->
            <!-- PESTAÑA 6: HISTORIAL DE TRAZABILIDAD -->
            <!-- ========================================================= -->
            <LinearLayout
                android:id="@+id/content_tab_historial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/blanco"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#E2E8F0"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/historial_de_movimientos"
                            android:textColor="@color/texto_principal"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="16dp"
                            android:text="@string/trazabilidad_cambios_estado"
                            android:textColor="@color/gris_texto"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:id="@+id/container_trazabilidad"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

</ScrollView>
