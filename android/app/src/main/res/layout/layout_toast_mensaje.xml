<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="@dimen/msg_toast_padding_horizontal"
    android:paddingVertical="@dimen/msg_toast_padding_vertical"
    android:background="@color/texto_principal"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/toast_icono"
        android:layout_width="@dimen/msg_toast_icon_size"
        android:layout_height="@dimen/msg_toast_icon_size"
        android:layout_marginEnd="8dp"
        android:contentDescription="@string/icono" />

    <TextView
        android:id="@+id/toast_texto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/blanco"
        android:textSize="@dimen/msg_toast_text_size"
        android:includeFontPadding="false" />

</LinearLayout>
